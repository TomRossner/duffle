# /srv/duffle/shared/.env  (chmod 600, owned by duffle)
# Read by systemd, the deploy script, and the backup script. Keep KEY="value" form.

DATABASE_URL="postgresql://duffle:CHANGE_ME@127.0.0.1:5432/duffle"

AUTH_URL="https://duffle.tomrossner.dev"
# openssl rand -base64 33
AUTH_SECRET=""
# Keeps server actions working across deploys for pages that are already open.
# openssl rand -base64 32   (set once, never rotate casually)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Resend SMTP. SMTP_FROM must use a domain verified in Resend.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="resend"
SMTP_PASSWORD=""
SMTP_FROM="Duffle <no-reply@tomrossner.dev>"

UPLOADS_DIR="/srv/duffle/shared/uploads"

# Google sign-in. Authorized redirect URI:
# https://duffle.tomrossner.dev/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Browser key: loads the map. Restrict to websites: https://duffle.tomrossner.dev/*
# and to the Maps JavaScript API.
GOOGLE_MAPS_API_KEY=""
# Server key: place search and address lookup run on the server, which sends no referrer.
# Restrict to IP addresses (the VPS IP) and to Places API (New) and Geocoding API.
GOOGLE_MAPS_SERVER_KEY=""

# Optional: object storage instead of UPLOADS_DIR.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"

# Optional: web push. npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tomrossner2@gmail.com"

# Optional: AI clothing suggestions and reading document numbers/dates from uploads.
NEON_AI_GATEWAY_BASE_URL=""
NEON_AI_GATEWAY_TOKEN=""
PACKING_AGENT_MODEL=""
DOCUMENT_AGENT_MODEL=""

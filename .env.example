DATABASE_URL="postgresql://trip:trip@localhost:5432/tripplanner"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Password sign-up, email confirmation, and password reset.
# Leave these unset in local development to print the link in the server log.
SMTP_HOST=""
SMTP_PORT="2465"
SMTP_SECURE="true"
SMTP_USER="resend"
SMTP_PASSWORD=""
SMTP_FROM=""

# Directory for uploaded images when S3_* is unset.
# On a VPS, point this outside the app directory so a new release keeps the files.
UPLOADS_DIR=""
# Google account sign-in. Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
GOOGLE_MAPS_API_KEY=""
# Optional key for server-side place search and geocoding. Falls back to GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_SERVER_KEY=""

# Production image storage (Cloudflare R2 or any S3-compatible API).
# When these are unset, uploads are stored in UPLOADS_DIR, or under ./uploads.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"

# Browser push. Generate with: npx web-push generate-vapid-keys
# When these are unset, the in-app bell still works and push is skipped.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@localhost"

# AI features. When both are set, Suggest clothes asks the Neon AI Gateway (falling back
# to the scored list if the call fails), and Add a document reads the number and dates
# from the uploaded file. `neon deploy` writes these after aiGateway is enabled in neon.ts.
NEON_AI_GATEWAY_BASE_URL=""
NEON_AI_GATEWAY_TOKEN=""
# Optional catalog model ids. All default to gemini-3-flash; the document model must accept images and PDFs, the closet model images.
PACKING_AGENT_MODEL=""
DOCUMENT_AGENT_MODEL=""
CLOSET_AGENT_MODEL=""
